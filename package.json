{
  "name": "sharad-utsav",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-launch.mjs dev",
    "build": "next build",
    "start": "node scripts/next-launch.mjs start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@next/env": "15.5.28",
    "drizzle-orm": "0.45.4",
    "next": "15.5.28",
    "pg": "8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.20.0"
}
