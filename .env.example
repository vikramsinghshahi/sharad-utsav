# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string. The driver is chosen from this URL:
#   - a *.neon.tech host uses the Neon serverless (WebSocket) driver
#   - anything else (e.g. localhost) uses node-postgres
# Local:  postgres://<user>@localhost:5432/sharad_utsav_dev
# Neon:   postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require
DATABASE_URL=
# Optional: preferred port for `pnpm dev`. If it is taken, the next free port is used.
PORT=3000

# Secret for the daily hold-expiry cron (GET /api/cron/expire-holds). At least 16 chars.
# Generate with: openssl rand -hex 32. Set the same value in Vercel.
CRON_SECRET=

# Integration tests only (pnpm test:integration). Put this in .env.test.local, not
# .env.local: Next.js loads .env.test.local when NODE_ENV=test. Must be a separate
# database whose name contains "test"; the tests wipe it.
# TEST_DATABASE_URL=postgres://<user>@localhost:5432/sharad_utsav_test

# Optional: site title and one-line description (public, inlined at build time).
# Event names, venues, dates and prices come from the database, not from here.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DESCRIPTION=
